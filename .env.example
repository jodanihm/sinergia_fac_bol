# .env.example -- sinergia_fac_bol
# Plantilla de referencia. NO contiene valores reales.
# Los valores reales viven FUERA del arbol, en:
#   /mnt/tank/secretos/sinergia_fac_bol/env/sinergia.env
#   /mnt/tank/secretos/sinergia_fac_bol/env/mysql.env
# El docker-compose.yml los carga desde ahi via env_file. Este archivo
# solo documenta que variables espera cada servicio.

# --- env/sinergia.env  (sinergia_motor y sinergia_panel) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
CRYPTO_MASTER_KEY=
# URL base del motor DTE que el panel llama por HTTP para emitir (M3).
# En sinergia_net resuelve por DNS al contenedor del motor, puerto 80.
MOTOR_URL=

# --- Envio de DTE por correo al receptor (cola dte_envio_correo, migracion 024).
# Las usa scripts/enviar_correo.php, que corre en el contenedor del MOTOR.
#
# BREVO_API_KEY            Clave de la API HTTP de Brevo (cabecera api-key de
#                          POST https://api.brevo.com/v3/smtp/email). SIN valor
#                          por defecto y sin degradacion silenciosa: si falta, el
#                          envio ABORTA en vez de intentar mandar a ninguna parte.
# CORREO_REMITENTE         Direccion unica del sistema desde la que sale TODO
#                          correo. No es la del tenant: el dominio tiene que
#                          estar verificado en Brevo o los correos rebotan.
# CORREO_REMITENTE_NOMBRE  Nombre visible de respaldo, para cuando no se pueda
#                          resolver la razon social del emisor. Lo normal es que
#                          el receptor vea el nombre de la EMPRESA EMISORA, que
#                          sale de dte_emisor; esto es solo el fallback.
#                          Brevo limita el nombre del remitente a 70 caracteres.
#
# La respuesta del receptor NO vuelve a CORREO_REMITENTE: el Reply-To se arma con
# cuenta.email del tenant, para que conteste a la empresa que emitio.
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=

# --- Consulta de contribuyente por RUT (GET /api/v1/contribuyente del motor).
#
# APIGATEWAY_TOKEN  Token de app.apigateway.cl. Viaja en la cabecera
#                   "Authorization: Token <valor>" -- prefijo literal "Token",
#                   NO "Bearer": confundirlos da 401.
#
# La usa src/Providers/ApiGatewayContribuyente.php, que corre en el contenedor
# del MOTOR (es el que tiene salida a internet, igual que los runners de correo).
#
# SI FALTA, NADA SE ROMPE, Y ES DELIBERADO. A diferencia de BREVO_API_KEY -- sin
# la cual el envio aborta --, aqui la ausencia se traduce en un mensaje en
# pantalla y el usuario completa los datos de la empresa a mano, que es como se
# hacia antes de esta consulta. Un autocompletado caido no puede impedir dar de
# alta una empresa.
#
# CADA CONSULTA CUESTA CREDITOS al proveedor: el motor no cachea ni reintenta, y
# la pantalla consulta una vez por pulsacion del boton.
APIGATEWAY_TOKEN=

# --- Chat de consultas: traduccion de la pregunta a los parametros de consulta.
#
# DEEPSEEK_API_KEY  Clave de api.deepseek.com. Viaja en la cabecera
#                   "Authorization: Bearer <valor>" -- aqui SI es "Bearer", a
#                   diferencia de APIGATEWAY_TOKEN, que usa el prefijo literal
#                   "Token". Confundirlos da 401 en los dos sentidos.
#
# La usa src/Providers/DeepSeekTraductorPregunta.php, y va en env/sinergia.env
# como todas las de arriba: ESTE PROYECTO NO TIENE UN ARCHIVO POR SERVICIO. Hay
# un solo sinergia.env que cargan sinergia_motor y sinergia_panel por el mismo
# env_file, igual que se hizo con APIGATEWAY_TOKEN.
#
# SI FALTA, NADA SE ROMPE, y es el mismo criterio que APIGATEWAY_TOKEN: el chat
# responde que no esta configurado y el usuario sigue teniendo los seis informes
# del menu. Un chat caido no puede impedir entrar al panel.
#
# AL MODELO SOLO VIAJA LA PREGUNTA DEL USUARIO: ni cuenta_id, ni RUT, ni totales,
# ni una fila de la base. La consulta la hace el codigo con las perillas que el
# modelo eligio, y esas perillas se validan aqui antes de tocar la base.
#
# LIMITE CONOCIDO: si el usuario escribe el nombre de un cliente en su pregunta,
# ese nombre viaja dentro de la pregunta. No se filtra.
#
# CADA CONSULTA CUESTA: no se cachea ni se reintenta.
DEEPSEEK_API_KEY=

# --- env/mysql.env  (sinergia_mysql) ---
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# URL publica del panel (para el urlConfirmation de la pasarela de pago)
PANEL_URL_PUBLICA=https://facturacion.ejemplo.cl
