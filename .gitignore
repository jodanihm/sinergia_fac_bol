# ============================================================================
# .gitignore -- sinergia_fac_bol
# ============================================================================

# --- Bloque 0: lo que el .gitignore anterior ya excluia (se conserva) ---
/vendor/
# composer.lock SI SE VERSIONA desde el 25-08-2026. Estaba aqui por herencia
# -- este bloque conserva lo que excluia el .gitignore anterior --, no por una
# decision. Sin el, cada construccion de imagen resolvia versiones frescas y el
# VPS podia terminar con dependencias distintas a las de cualquier otra maquina.
# No fue teorico: tecnickcom/tcpdf estaba declarado como "*", produccion corria
# 6.11.3 y un install nuevo traia 7.0.6, que es otra libreria. Los PDF seguian
# saliendo solo porque la capa de docker estaba cacheada desde el 26-07.
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
.idea/
.vscode/

# --- Bloque A1: secretos por extension (cualquier nivel) ---
*.pem
*.key
*.pfx
*.p12
*.crt
# Mismo material que los de arriba, en las otras extensiones habituales:
# .cer y .der son certificados igual que .crt; .jks y .keystore son almacenes
# de claves; .p8 es una clave privada PKCS#8; .ppk es el formato de PuTTY.
# De estos solo existen hoy oracle/LibreDTE-master/certs/{100,300}.cer, que ya
# quedaban fuera por /oracle/; ahora tienen cobertura por extension tambien.
# El resto se agrega antes de tener remoto: con un remoto configurado, un
# descuido deja de ser reversible.
*.cer
*.der
*.jks
*.keystore
*.p8
*.ppk

# --- Bloque A2: secretos por nombre (cualquier nivel) ---
.crypto_master_key
.crypto_master_key.*
.fact_api_key
.rcv_internal_key
# Claves SSH y archivos de credenciales de herramientas. Tampoco existen hoy
# aqui, pero son los que se cuelan al copiar un home o un contenedor.
id_rsa
id_dsa
id_ecdsa
id_ed25519
.netrc
.npmrc
.pgpass
.htpasswd

# --- Bloque A3: archivos de entorno con valores (no el example) ---
.env
*.env
!/.env.example

# --- Bloque A4: CAF (folios firmados por el SII) por nombre, cualquier nivel ---
*CAF*.xml
*caf*.xml
*Caf*.xml
FoliosSII*.xml

# --- Bloque A5: carpetas con material sensible disperso ---
/sinergia/
/easyagenda/
/folios_reales/

# --- Bloque B: datos (nunca a git) ---
/mysql_data/

# --- Bloque C1: directorios de residuo/regenerables ---
/graphify-out/
/oracle/
/muestras/
/muestras_v2/
/brewer_ppt/
/debug/
/audit/

# --- Bloque C2: residuo suelto en la RAIZ, por extension (solo nivel raiz) ---
/*.php
/*.xml
/*.json
/*.pdf
/*.txt
/*.docx
/*.sql
/*.gz
/*.b64
/*.bak
/*.bak.*
/*.bak_*

# --- Bloque C3: residuo por patron de nombre en la raiz ---
/DTEMAIL*
/SETMAIL*
/FOLMAIL*
/patch_*.php
/fix_*.php

# --- Bloque C4: residuo de sistema operativo (cualquier nivel) ---
Thumbs.db
desktop.ini

# --- Bloque E: exclusiones adicionales confirmadas (residuo y no-producto) ---
# handoffs previos sueltos en la raiz (ya reemplazados)
/PROMPT_CONTINUIDAD*.md
# config local del editor/herramienta (mismo trato que .vscode/ y .idea/)
/.claude/
# documentacion oficial del SII (33M, 1131 PNG); no son originales del proyecto
/docs/*
# ... salvo los XSD oficiales del SII: son el contrato con el que validamos,
# pesan 131 KB de los 33 MB, y sin ellos el test que ata ImpuestoAdicional al
# esquema no puede correr fuera de esta maquina.
!/docs/18_Schema_XML_DTE/
/docs/18_Schema_XML_DTE/*
!/docs/18_Schema_XML_DTE/*.xsd
# scripts de la migracion de seguridad y de prueba (no del producto)
/paso*.sh
/probar_certificado.sh
# pertenece al proyecto hermano boletas_facturas
/run_facturacion_api.sh
# residuo vacio
/respondemos
# backups .bak en CUALQUIER nivel (los /*.bak* de C2 cubren solo la raiz)
*.bak*

# --- Bloque D: reincluir los legitimos de la raiz que C2 excluiria ---
!/composer.json
!/phpunit.xml
!/estructura_facturacion_cl.sql
!/docker-compose.yml
!/.env.example
!/.gitignore
!/.graphifyignore
!/README.md
!/CLAUDE.md
!/Dockerfile.php
